---
profile: min

skip_list:
  - no-free-form
  - yaml[truthy]
  - yaml[line-length]
  - name[template]
  - var-naming[no-role-prefix]
  - galaxy[no-runtime]

exclude_paths:
  - group_vars/
  - roles/

warn_list:
  - experimental

mock_modules:
  - community.general.timezone
  - community.general.ufw
  - ansible.posix.authorized_key

offline: false
